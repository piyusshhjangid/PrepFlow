# PrepFlow web app build-time configuration (Vite). Copy to apps/web/.env if you need it.
# Values prefixed with VITE_ are embedded in the public JavaScript bundle: never put secrets here.

# Leave unset when the API is served from the same origin as the web app (or proxied at /api).
# Set it when the API lives on a different host, e.g. https://prepflow-api.example.com
# (no trailing slash, no /api suffix). The API's CLIENT_URL must then include this web app's origin.
# VITE_API_BASE_URL=

# Development only: where the Vite dev server proxies /api (default http://localhost:4000).
# VITE_API_PROXY_TARGET=http://localhost:4000
