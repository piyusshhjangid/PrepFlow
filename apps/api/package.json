{
  "name": "@prepflow/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "prisma generate",
    "db:migrate": "tsx scripts/prisma-run.ts migrate dev",
    "db:deploy": "tsx scripts/prisma-run.ts migrate deploy",
    "db:seed": "tsx prisma/seed.ts",
    "db:studio": "tsx scripts/prisma-run.ts studio",
    "postinstall": "prisma generate",
    "pdf:inspect": "tsx scripts/inspect-pdf.ts",
    "test:integration": "tsx scripts/run-integration-tests.ts",
    "db:test:setup": "tsx scripts/prisma-run.ts --test migrate deploy",
    "db:check": "tsx scripts/db-check.ts",
    "db:check:test": "tsx scripts/db-check.ts --test",
    "ai:smoke": "tsx scripts/ai-smoke.ts"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@prepflow/shared": "*",
    "@prisma/client": "~6.19.0",
    "cors": "^2.8.5",
    "dotenv": "^17.0.0",
    "express": "^5.1.0",
    "express-rate-limit": "^8.7.0",
    "helmet": "^8.1.0",
    "multer": "^2.4.0",
    "pdfjs-dist": "^6.3.289",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.0",
    "@types/multer": "^2.3.0",
    "@types/node": "^22.0.0",
    "@types/supertest": "^6.0.0",
    "prisma": "~6.19.0",
    "supertest": "^7.1.0",
    "tsx": "^4.20.0",
    "vitest": "^3.2.0"
  }
}
