# PrepFlow API configuration. Copy to apps/api/.env and edit. Never commit the real .env file.
# Real environment variables (production) always override this file.

# --- Required -------------------------------------------------------------------------------
# Development / production database (PostgreSQL). URL-encode special characters in the password.
DATABASE_URL="postgresql://prepflow:prepflow@localhost:5432/prepflow?schema=public"
# Allowed browser origin(s) for CORS, comma-separated. In production use the exact public URL of the web app.
CLIENT_URL="http://localhost:5173"

# --- Integration tests ----------------------------------------------------------------------
# A SEPARATE disposable database. Its name must contain "test" and it must differ from DATABASE_URL.
# Integration tests clear tables in this database.
TEST_DATABASE_URL="postgresql://prepflow:prepflow@localhost:5432/prepflow_test?schema=public"

# --- Server ---------------------------------------------------------------------------------
PORT=4000
NODE_ENV=development

# --- AI provider ----------------------------------------------------------------------------
# ollama (default, local Gemma) | gemini (hosted, needs GEMINI_API_KEY) | fake (tests/demos only; rejected in production)
AI_PROVIDER=ollama
# AI_MODEL=

OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=gemma4:e4b
OLLAMA_NUM_CTX=16384

# Only needed when AI_PROVIDER=gemini. Keep this server-side; never expose it to the web app.
# GEMINI_API_KEY=
# GEMINI_MODEL=gemma-4-26b-a4b-it
# GEMINI_BASE_URL=https://generativelanguage.googleapis.com

# AI_REQUEST_TIMEOUT_MS=180000
# AI_MAX_ATTEMPTS=3
# AI_RETRY_BASE_DELAY_MS=1000
# AI_CHUNK_TARGET_CHARS=
# AI_CHUNK_MAX_CHARS=
# AI_MAX_CHUNKS=40

# --- Analysis limits ------------------------------------------------------------------------
# ANALYSIS_MAX_CONCURRENT=1
# ANALYSIS_STALE_AFTER_MS=900000
# ANALYSIS_RATE_LIMIT=10
# ANALYSIS_RATE_WINDOW_MINUTES=60

# --- Material limits (defaults: 10 MB, 100 pages, 200000 chars, 10 materials) ----------------
# MAX_PDF_MB=10
# MAX_PDF_PAGES=100
# MAX_MATERIAL_CHARS=200000
# MAX_MATERIALS_PER_EXAM=10
