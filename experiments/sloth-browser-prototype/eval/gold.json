{
  "version": "gold-v1",
  "note": "Reference topics written by the project author from reading each sample BEFORE any model was run on it. Single annotator, not independently reviewed. A gold topic counts as found when a verified topic's NAME matches its regular expression (case-insensitive). 'high' marks topics whose importance the material itself states; 'ambiguous' marks topics where the material contradicts itself, so neither answer is scored. 'referenceOrder' is the order a careful student would study them (prerequisites first, stated weighting early); it is an opinion, which is why agreement with it is reported as a rough indicator only.",
  "samples": {
    "01-structured-syllabus": {
      "topics": [
        { "id": "relational", "match": "relational|keys" },
        { "id": "sql", "match": "sql basics|select|query|queries" },
        { "id": "joins", "match": "join" },
        { "id": "aggregation", "match": "aggregat|group by", "high": true },
        { "id": "normalization", "match": "normali|normal form" },
        { "id": "transactions", "match": "transaction|acid" },
        { "id": "indexes", "match": "index" }
      ],
      "referenceOrder": [
        "relational",
        "sql",
        "aggregation",
        "joins",
        "normalization",
        "transactions",
        "indexes"
      ]
    },
    "02-dense-lecture-notes": {
      "topics": [
        { "id": "process", "match": "process(?! state| scheduling)|control block|pcb" },
        { "id": "context", "match": "context switch" },
        { "id": "states", "match": "process state|state" },
        {
          "id": "basic-scheduling",
          "match": "first come|fcfs|shortest job|round robin|scheduling algorithm|cpu scheduling|^scheduling$"
        },
        { "id": "priority", "match": "priority|aging|starvation" },
        { "id": "mlfq", "match": "multilevel|feedback" }
      ],
      "referenceOrder": ["process", "states", "context", "basic-scheduling", "priority", "mlfq"]
    },
    "03-repeated-overlapping": {
      "topics": [
        { "id": "reliability", "match": "reliab|retransmi|tcp(?! congestion)" },
        { "id": "congestion", "match": "congestion|slow start" },
        { "id": "udp", "match": "udp" }
      ],
      "referenceOrder": ["reliability", "congestion", "udp"]
    },
    "04-ambiguous-headings": {
